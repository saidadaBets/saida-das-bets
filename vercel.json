{
  "headers": [
    {
      "source": "/(financeiro|upsell|downsell|acesso)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/programa/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/oferta-v2.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/programa/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/programa/",
      "permanent": false
    },
    {
      "source": "/obrigado.html",
      "destination": "/acesso.html",
      "permanent": false
    },
    {
      "source": "/obrigado",
      "destination": "/acesso.html",
      "permanent": false
    }
  ]
}
